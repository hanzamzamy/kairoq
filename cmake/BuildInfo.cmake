# Writes the source of the build information (version, git commit, compiler, platform):
# run at every build (cmake -P), so that the commit follows the tree; the file is rewritten
# only when its content changes.
# Inputs: OUTPUT, SOURCE_DIR, VERSION, COMPILER, PLATFORM.
set(commit "unknown")
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
    if(rc EQUAL 0)
        set(commit "${head}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${SOURCE_DIR}"
                        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT changes STREQUAL "")
            set(commit "${commit}+modified")
        endif()
    endif()
endif()
set(content "// Generated by cmake/BuildInfo.cmake.
#include \"kairoq/provenance.hpp\"

namespace kairoq {

BuildInfo build_info() { return {\"${VERSION}\", \"${commit}\", \"${COMPILER}\", \"${PLATFORM}\"}; }

}  // namespace kairoq
")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
